        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^9.0.7",
        "@vitest/coverage-v8": "^4.1.8",
        "eslint": "^8.56.0",
        "fast-check": "^4.8.0",
        "socket.io-client": "^4.8.3",
