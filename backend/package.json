        "csv-parser": "^3.2.1",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.3.2",
        "habit": "file:..",
        "ioredis": "5.10.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.10",
        "pg": "^8.11.3",
