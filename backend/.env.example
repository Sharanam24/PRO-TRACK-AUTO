# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=protrack_auto
DB_USER=postgres
DB_PASSWORD=Bela@1711
DB_URL=postgresql://postgres:Bela@1711@localhost:5432/protrack_auto

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production

# ──────────────────────────────────────────────────────────────────────────────
# Optional: SMTP Configuration (required for email verification and password reset)
# ──────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com

# ──────────────────────────────────────────────────────────────────────────────
# Optional: Redis Configuration (required for analytics caching)
# ──────────────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────────────────────
# Optional: JWT Refresh Token Configuration
# ──────────────────────────────────────────────────────────────────────────────
# JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
# JWT_REFRESH_EXPIRES_IN=30d

# ──────────────────────────────────────────────────────────────────────────────
# Optional: S3 File Storage (if not set, falls back to local disk storage)
# ──────────────────────────────────────────────────────────────────────────────
# S3_BUCKET=your-s3-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key

# ──────────────────────────────────────────────────────────────────────────────
# Optional: Email Verification Bypass (set to true to skip email verification)
# ──────────────────────────────────────────────────────────────────────────────
# EMAIL_VERIFICATION_DISABLED=false
